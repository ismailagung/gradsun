# Supabase PostgreSQL Database (Transaction Pooler - Port 6543)
DATABASE_URL="placeholder-postgres://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Database (Direct Connection - Port 5432 for prisma migrate)
DIRECT_URL="placeholder-postgres://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth Configuration
BETTER_AUTH_SECRET="placeholder-32-character-secret-key-min"
BETTER_AUTH_URL="http://localhost:3000"

# Supabase Storage via S3 API (@aws-sdk/client-s3)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://your-ref.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_BUCKET="photos"
S3_ACCESS_KEY_ID="placeholder-supabase-s3-access-key-id"
S3_SECRET_ACCESS_KEY="placeholder-supabase-s3-secret-access-key"
NEXT_PUBLIC_STORAGE_BASE_URL="https://your-ref.supabase.co/storage/v1/object/public/photos"

# Cron Secret for Automated Reminders
CRON_SECRET="placeholder-cron-secret-16chars"

# Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
